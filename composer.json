{
    "name": "xqkeji/xq-res-click-captcha",
    "description": "文字点选验证码的PHP的Composer包。",
    "type": "library",
    "license": "AGPL-3.0-only",
    "autoload": {
        "psr-4": {
            "xqkeji\\composer\\xq-click-captcha\\": ""
        }
    },
    "authors": [
        {
            "name": "xqkeji.cn"
        }
    ],
    "extra": {
        "post-package-install":[
            {
                "cmd":["xqkeji\\composer\\Asset","copyDirs"],
                "param":[{
                    "vendor/xqkeji/xq-res-click-captcha/src/":"www/asset/xq-click-captcha/"
                }]
            }
        ],
        "post-package-update":[
            {
                "cmd":["xqkeji\\composer\\Asset","rmDirs"],
                "param":[{
                    "www/asset/xq-click-captcha/":"www/asset/xq-click-captcha/"
                }]
            },
            {
                "cmd":["xqkeji\\composer\\Asset","copyDirs"],
                "param":[{
                    "vendor/xqkeji/xq-res-click-captcha/src/":"www/asset/xq-click-captcha/"
                }]
            }
        ],
        "post-package-uninstall":[
            {
                "cmd":["xqkeji\\composer\\Asset","rmDirs"],
                "param":[{
                    "www/asset/xq-click-captcha/":"www/asset/xq-click-captcha/"
                }]
            }
        ]
    },
    "require": {
        "xqkeji/composer":"^1.0"
    }
}
